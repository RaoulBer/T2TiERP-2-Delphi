unit UDataModuleConexaoDiagnosticV2b;
interface
uses System.SysUtils, Data.SqlExpr, Data.DBXCommon;
type TFDataModuleConexao = class
 private FConnection: TSQLConnection;
 public constructor Create;
 destructor Destroy; override;
 function getBanco: String;
 function getConexao: TSQLConnection;
end;
var FDataModuleConexao: TFDataModuleConexao;
function GetConstructorDiagnosticStep: String;
implementation
uses System.Classes, System.IOUtils, System.Hash, Dbx34Drv;
var ConstructorDiagnosticStep: String;
function GetConstructorDiagnosticStep: String;
begin Result:=ConstructorDiagnosticStep;end;
function RequiredEnv(const Name: string): string;
begin Result:=GetEnvironmentVariable(Name);if Result='' then raise Exception.Create('Missing functional connection input');end;
constructor TFDataModuleConexao.Create;
var Properties: TDBXOpenOdbcProperties; LibraryPath, Expected: string;
 Stream: TFileStream; Digest: THashSHA2; Buffer: TBytes; Count: Integer;
begin
 ConstructorDiagnosticStep:='INHERITED_CREATE';
 inherited Create;
 ConstructorDiagnosticStep:='ARCHITECTURE_GUARD';
 if SizeOf(Pointer)<>4 then raise Exception.Create('Win32 worker required');
 ConstructorDiagnosticStep:='PRIVATE_ACK_GUARD';
 if RequiredEnv('T2TI_MYSQL_ISOLATED')<>'YES' then raise Exception.Create('Private disposable database acknowledgement required');
 ConstructorDiagnosticStep:='DRIVER_PATH_RESOLVE';
 LibraryPath:=TPath.GetFullPath(TPath.Combine(ExtractFilePath(ParamStr(0)),'dbxoodbc.dll'));
 ConstructorDiagnosticStep:='DRIVER_PATH_GUARD';
 if not SameText(Copy(LibraryPath,1,16),'C:\build-inputs\') or not SameText(ExtractFileName(LibraryPath),'dbxoodbc.dll') then raise Exception.Create('Driver path binding invalid');
 ConstructorDiagnosticStep:='DRIVER_HASH_INPUT';
 Expected:=RequiredEnv('T2TI_OPEN_DBX_SHA256');
 ConstructorDiagnosticStep:='DRIVER_HASH_INPUT_GUARD';
 if Length(Expected)<>64 then raise Exception.Create('Driver hash binding invalid');
 ConstructorDiagnosticStep:='DRIVER_FILE_OPEN';
 Stream:=TFileStream.Create(LibraryPath,fmOpenRead or fmShareDenyWrite);
 try
 ConstructorDiagnosticStep:='DRIVER_HASH_CREATE';
  Digest:=THashSHA2.Create;SetLength(Buffer,65536);
 ConstructorDiagnosticStep:='DRIVER_HASH_READ';
  repeat Count:=Stream.Read(Buffer[0],Length(Buffer));if Count>0 then begin SetLength(Buffer,Count);Digest.Update(Buffer);SetLength(Buffer,65536);end;until Count=0;
 ConstructorDiagnosticStep:='DRIVER_HASH_COMPARE';
  if not SameText(Digest.HashAsString,Expected) then raise Exception.Create('Driver hash binding invalid');
 finally Stream.Free;end;
 ConstructorDiagnosticStep:='SQL_CONNECTION_CREATE';
 FConnection:=TSQLConnection.Create(nil);
 ConstructorDiagnosticStep:='SQL_CONNECTION_CREATED';
 try
  ConstructorDiagnosticStep:='LOGIN_PROMPT';
  FConnection.LoginPrompt:=False;
  ConstructorDiagnosticStep:='SET_DRIVER_NAME_ENTER';
  FConnection.DriverName:='DbxOpenOdbc';
  ConstructorDiagnosticStep:='SET_DRIVER_NAME_RETURN';
 ConstructorDiagnosticStep:='ODBC_PROPERTIES_CREATE';
  Properties:=TDBXOpenOdbcProperties.Create(nil);
 ConstructorDiagnosticStep:='ODBC_PROPERTIES_CREATED';
 ConstructorDiagnosticStep:='PARAMETERS_ASSIGN';
  try FConnection.Params.Assign(Properties.Properties);finally Properties.Free;end;
 ConstructorDiagnosticStep:='LIBRARY_NAME_AND_FACTORY';
  FConnection.LibraryName:=LibraryPath;FConnection.GetDriverFunc:='getSQLDriverODBCW';
 ConstructorDiagnosticStep:='VENDOR_LIBRARY';
  FConnection.VendorLib:='odbc32.dll';
 ConstructorDiagnosticStep:='PARAM_LIBRARY_NAME';
  FConnection.Params.Values['LibraryName']:=LibraryPath;
 ConstructorDiagnosticStep:='PARAM_FACTORY';
  FConnection.Params.Values['GetDriverFunc']:='getSQLDriverODBCW';
 ConstructorDiagnosticStep:='PARAM_VENDOR_LIBRARY';
  FConnection.Params.Values['VendorLib']:='odbc32.dll';
 ConstructorDiagnosticStep:='PARAM_DATABASE';
  FConnection.Params.Values['Database']:=RequiredEnv('T2TI_MYSQL_DSN');
 ConstructorDiagnosticStep:='PARAM_USER_NAME';
  FConnection.Params.Values['User_Name']:=RequiredEnv('T2TI_MYSQL_USER');
 ConstructorDiagnosticStep:='PARAM_PASSWORD';
  FConnection.Params.Values['Password']:=RequiredEnv('T2TI_MYSQL_PASSWORD');
  ConstructorDiagnosticStep:='KEEP_CONNECTION';
  FConnection.KeepConnection:=True;
  ConstructorDiagnosticStep:='AUTO_CLONE';
  FConnection.AutoClone:=False;
  ConstructorDiagnosticStep:='CONNECTED_ENTER';
  FConnection.Connected:=True;
  ConstructorDiagnosticStep:='CONNECTED_RETURN';
 except FConnection.Free;FConnection:=nil;raise;end;
end;
destructor TFDataModuleConexao.Destroy;
begin FConnection.Free;inherited;end;
function TFDataModuleConexao.getBanco: String;
begin Result:='MySQL';end;
function TFDataModuleConexao.getConexao: TSQLConnection;
begin Result:=FConnection;end;
end.
